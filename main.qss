* {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
}

QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-size: 16px;
}
QToolTip {
    padding: 2px;
    background-color: {{surface}};
    color: {{subtext}};
    font-size: 12px;
}

/* TOOLBAR, TOP BAR, BUTTONS */
QToolBar {
    background: {{mantle}};
    border-bottom: 2px solid {{border}};
}

QToolButton {
    background: transparent;
    padding: 2px 2px;
    color: {{fg}};
}

QToolButton:hover {
    background: {{hover}};
}

QToolButton:pressed {
    background: {{active}};
}
QStatusBar {
    background: {{border}};
    color: {{fg}};
    font-size: 12px;
}

/* TEXT EDITOR */
QTextEdit {
    background: transparent;
    color: {{fg}};
    font-family: monospace;
    font-size: 16px;
    selection-background-color: {{active}};
    selection-color: {{fg}};
}
#welcomeLabel {
    background: transparent;
    font-size: 32px;
    color: {{primary}};
}

/* FOLDER */
#folderDock {
    background: {{crust}};
    border-right: 1px solid {{border}};
}
#folderDock::title {
    background: {{mantle}};
}
QTreeView {
    background: {{mantle}};
    color: {{fg}};
    border: none;
}
QTreeView::item:hover {
    background: {{hover}};
}
QTreeView::item:selected {
    background: {{active}};
    color: {{fg}};
}
